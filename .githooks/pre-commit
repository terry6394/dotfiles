#!/usr/bin/env bash
# Blocks committing a machine-local personalization of flake.nix.
#
# bootstrap.sh personalizes flake.nix's "user =" and "machine =" lines per
# machine. Those local changes must stay uncommitted so all machines share one
# canonical username and machine label on origin/main. Bypass only for a
# deliberate canonical rename:
#   git commit --no-verify
set -euo pipefail

# Only matters when flake.nix is staged.
if ! git diff --cached --name-only -- flake.nix | grep -q '^flake.nix$'; then
  exit 0
fi

# Skip merges git drives itself (MERGE_HEAD commits carry no staged intent).
if git rev-parse -q --verify MERGE_HEAD >/dev/null; then
  exit 0
fi

read_value() { # $1 = tree-ish prefix ending in ":" (":" alone = staged index); $2 = key
  git show "${1}flake.nix" 2>/dev/null \
    | sed -nE "s/^[[:space:]]*${2} = \"([^\"]+)\";.*/\1/p" | head -n1
}

for KEY in user machine; do
  NEW="$(read_value : "$KEY")"
  [ -z "$NEW" ] && continue

  MAIN="$(read_value origin/main: "$KEY" || true)"
  if [ -z "$MAIN" ]; then
    MAIN="$(read_value HEAD: "$KEY" || true)"
  fi
  [ -z "$MAIN" ] || [ "$NEW" = "$MAIN" ] && continue

  cat >&2 <<EOF
pre-commit: blocked - flake.nix $KEY is "$NEW" but the shared baseline
(origin/main) has "$MAIN". This is almost always the machine-local
personalization bootstrap.sh wrote for this Mac. Keep it uncommitted:

  git restore --staged flake.nix

then commit the rest. If you truly mean to rename the canonical $KEY for all
machines, commit with:

  git commit --no-verify
EOF
  exit 1
done
exit 0
